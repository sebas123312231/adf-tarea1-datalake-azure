{
	"name": "df_ventas_online_bronze_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_online_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ventas_sc_limpia_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          timestamp as string,",
				"          product as string,",
				"          qty as string,",
				"          unit_price as string,",
				"          {customer/name} as string,",
				"          {customer/email} as string,",
				"          {customer/city} as string,",
				"          payment_method as string,",
				"          status as string,",
				"          shipping_cost as string,",
				"          channel as string,",
				"          customer as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_venta = order_id,",
				"          fecha = timestamp,",
				"          producto = product,",
				"          cantidad = qty,",
				"          precio_unitario = unit_price,",
				"          cliente_nombre = {customer/name},",
				"          cliente_email = {customer/email},",
				"          sucursal = {customer/city},",
				"          metodo_pago = payment_method,",
				"          canal = channel",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_venta = trim(id_venta),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          cliente_nombre = trim(cliente_nombre),",
				"          cliente_email = trim(cliente_email),",
				"          sucursal = trim(sucursal),",
				"          metodo_pago = trim(metodo_pago),",
				"          canal = trim(canal)) ~> derivedColumn1",
				"derivedColumn1 derive(fecha = coalesce(    toDate(fecha,'yyyy-MM-dd'),    toDate(fecha,'dd-MM-yyyy'),    toDate(fecha,'MM-dd-yyyy'),    toDate(fecha,'dd/MM/yyyy'),    toDate(fecha,'yyyy/MM/dd'),    toDate(fecha,'dd/MMM/yyyy'),    toDate(fecha,'dd-MMM-yyyy'),    toDate(fecha,'MMMM dd, yyyy'))) ~> derivedColumn2",
				"derivedColumn2 derive(cantidad = toInteger(cantidad),",
				"          precio_unitario = toFloat(regexReplace(toString(precio_unitario), '[^0-9.]', ''))) ~> derivedColumn3",
				"derivedColumn3 derive(producto = initCap(trim(regexReplace(producto,'\\\\s+', \" \")))) ~> derivedColumn4",
				"derivedColumn4 derive(sucursal = iif( in(['LPZ','La Paz','LP','la paz','LA PAZ','Lapaz','L.P.','LAPAZ'], sucursal), 'La Paz', \r",
				"iif( in(['CBBA','Cochabamba','CBB','cochabamba','COCHABAMBA','Cbba','Cba','Coch'], sucursal), 'Cochabamba', \r",
				"iif( in(['SCZ','Santa Cruz','SC','santa cruz','SANTA CRUZ','Santa cruz','SCruz'], sucursal), 'Santa Cruz', \r",
				"iif( in(['ORU','Oruro','OR','oruro','ORURO','Oru'], sucursal), 'Oruro', \r",
				"iif( in(['PTI','Potosi','PT','potosi','POTOSI','Potosí','potosí','POTOSÍ'], sucursal), 'Potosí', \r",
				"iif( in(['TJA','Tarija','TJ','tarija','TARIJA','Tar'], sucursal), 'Tarija', \r",
				"iif( in(['CHQ','Chuquisaca','CH','chuquisaca','CHUQUISACA','Chuqui','Sucre'], sucursal), 'Chuquisaca', \r",
				"iif( in(['BEN','Beni','BN','beni','BENI'], sucursal), 'Beni', \r",
				"iif( in(['PND','Pando','PA','pando','PANDO'], sucursal), 'Pando', sucursal)))))))))) ~> derivedColumn5",
				"derivedColumn5 filter(cantidad > 0 && !isNull(precio_unitario) && !isNull(fecha)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['ventas_online_limpio.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}